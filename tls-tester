            print('con certificado seran rechazados. Proporcione --ca-cert con la CA', file=sys.stderr)
            print('que emite el certificado del cliente (WAF), o use --no-mtls para', file=sys.stderr)
            print('no solicitar certificado de cliente.', file=sys.stderr)
            print('', file=sys.stderr)
        if not mtls_enabled and ca_cert_file:
            print('NOTA: Con --no-mtls y --ca-cert, el certificado de cliente es OPCIONAL', file=sys.stderr)
            print('pero SE VALIDA si el cliente lo presenta.', file=sys.stderr)
