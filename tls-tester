class DiagnosticHandler(BaseHTTPServer.BaseHTTPRequestHandler):
    """
    Handler HTTP que recopila y muestra toda la informacion de diagnostico
    sobre cada peticion entrante.
    """

    # Referencia al servidor padre para acceder a la configuracion
    server_config = None

    def log_message(self, format, *args):
        """Redirigimos el log del handler a stderr."""
        print('[{}] {}'.format(
            datetime.datetime.now().strftime('%H:%M:%S'),
            format % args
        ), file=sys.stderr)

    def setup(self):
        """
        Prepara la conexion y ejecuta el handshake TLS de forma EXPLICITA
        (con timeout) para poder diagnosticar los fallos de certificados/CA.
        """
        BaseHTTPServer.BaseHTTPRequestHandler.setup(self)
        if isinstance(self.request, ssl.SSLSocket):
            timeout = 10.0
            if self.server_config:
                try:
                    timeout = float(self.server_config.get('handshake_timeout', 10.0))
                except (TypeError, ValueError):
                    timeout = 10.0
            self.request.settimeout(timeout)
            try:
                self.request.do_handshake()
            except (ssl.SSLError, socket.timeout, socket.error) as e:
                self.request._tls_handshake_diag = self.build_handshake_failure_diag(e, timeout)
                raise TLSHandshakeFailure(str(e))
            finally:
                # Restaurar lecturas bloqueantes (como hasta ahora)
                self.request.settimeout(None)

    def build_handshake_failure_diag(self, exc, timeout):
        """Construye el dict de diagnostico de un fallo de handshake TLS."""
        now = utcnow()
        diag = {
            'event_type': 'tls_handshake_failure',
            'timestamp': now.strftime('%Y-%m-%d %H:%M:%S UTC'),
            'timestamp_iso': now.isoformat() + 'Z',
            'client': {
                'ip': self.client_address[0],
                'port': self.client_address[1],
            },
            'error': {
                'type': type(exc).__name__,
                'message': str(exc),
            },
            'server': {
                'hostname': socket.gethostname(),
                'pid': os.getpid(),
                'port': self.server.server_port,
                'python_short': '{}.{}.{}'.format(
                    sys.version_info.major,
                    sys.version_info.minor,
                    sys.version_info.micro,
                ),
                'openssl_version': ssl.OPENSSL_VERSION,
                'handshake_timeout': timeout,
            },
        }
        if self.server_config:
            diag['server']['mtls_enabled'] = self.server_config.get('mtls', False)
            diag['server']['mtls_mode'] = self.server_config.get('mtls_mode', 'none')
            if self.server_config.get('cert_file'):
                diag['server']['cert_file'] = self.server_config['cert_file']
            if self.server_config.get('ca_cert_file'):
                diag['server']['ca_cert_file'] = self.server_config['ca_cert_file']

        verify_code = getattr(exc, 'verify_code', None)
        verify_message = getattr(exc, 'verify_message', None)
        if verify_code is not None:
            diag['error']['verify_code'] = verify_code
            diag['error']['verify_message'] = verify_message

        leaf_der, chain_ders, leaf_info = get_peer_chain_objects(self.request)
        if leaf_der is not None:
            show_pem = bool(self.server_config and self.server_config.get('show_pem'))
            diag['client_certificate'] = describe_certificate(
                leaf_der, dict_info=leaf_info, role='cliente (rechazado)', show_pem=show_pem)
            if chain_ders:
                diag['client_certificate_chain'] = [
                    describe_certificate(d, role='intermedio') for d in chain_ders
                ]

        ca_configured = bool(self.server_config and self.server_config.get('ca_cert_file'))
        if leaf_der is not None and ca_configured:
            diag['openssl_verify'] = run_openssl_verify(
                leaf_der, chain_ders, self.server_config['ca_cert_file'])

        cert_reqs = None
        if self.server_config:
            cert_reqs = self.server_config.get('cert_reqs')
        diag['interpretacion'] = interpret_handshake_error(
            exc, verify_code, verify_message, leaf_der is not None,
            cert_reqs, ca_configured, timeout)

        if self.server_config and self.server_config.get('server_certificate'):
            diag['server_certificate'] = self.server_config['server_certificate']

        return diag

    def collect_diagnostics(self):
        """Recopila toda la informacion de diagnostico y la devuelve como dict."""
        diag = {}
        now = utcnow()

        # ---- Bloque E: Informacion del servidor ----
        diag['server'] = {
            'timestamp': now.strftime('%Y-%m-%d %H:%M:%S UTC'),
            'timestamp_iso': now.isoformat() + 'Z',
            'hostname': socket.gethostname(),
            'pid': os.getpid(),
            'port': self.server.server_port,
            'python_version': sys.version,
            'python_short': '{}.{}.{}'.format(
                sys.version_info.major,
                sys.version_info.minor,
                sys.version_info.micro,
            ),
            'openssl_version': ssl.OPENSSL_VERSION,
        }
        if self.server_config:
            diag['server']['mtls_enabled'] = self.server_config.get('mtls', False)
            diag['server']['mtls_mode'] = self.server_config.get('mtls_mode', 'none')
            diag['server']['http_mode'] = self.server_config.get('http_mode', False)
            diag['server']['self_signed_cert'] = self.server_config.get('self_signed', False)
            if self.server_config.get('cert_file'):
                diag['server']['server_cert_file'] = self.server_config['cert_file']
            if self.server_config.get('ca_cert_file'):
                diag['server']['ca_cert_file'] = self.server_config['ca_cert_file']
            if self.server_config.get('server_certificate'):
                diag['server_certificate'] = self.server_config['server_certificate']

        # ---- Bloque A: Informacion de conexion TLS ----
        tls_info = {}
        http_mode = self.server_config.get('http_mode', False) if self.server_config else False
        if http_mode:
            tls_info['note'] = 'Modo HTTP plano — sin cifrado TLS.'
        else:
            try:
                if hasattr(self.request, 'cipher'):
                    cipher = self.request.cipher()
                    if cipher:
                        tls_info['cipher_name'] = cipher[0]
                        tls_info['tls_version'] = cipher[1]
                        tls_info['secret_bits'] = cipher[2]
            except Exception as e:
                tls_info['cipher_error'] = str(e)
        diag['tls'] = tls_info

        # ---- Bloque B: Certificado del cliente (hoja + cadena) ----
        client_cert_info = {}
        chain_info = []
        try:
            http_mode = self.server_config.get('http_mode', False) if self.server_config else False
            if http_mode:
                client_cert_info['present'] = False
                client_cert_info['note'] = 'Modo HTTP (sin TLS): no hay certificado de cliente disponible.'
            else:
                leaf_der, chain_ders, leaf_info = get_peer_chain_objects(self.request)
                if leaf_der is not None:
                    show_pem = bool(self.server_config and self.server_config.get('show_pem'))
                    client_cert_info = describe_certificate(leaf_der, dict_info=leaf_info, show_pem=show_pem)
                    client_cert_info['present'] = True

                    # Marcar como raiz de confianza los certificados del bundle CA
                    ca_fingerprints = []
                    if self.server_config and self.server_config.get('ca_bundle'):
                        ca_fingerprints = self.server_config['ca_bundle'].get('fingerprints_sha256', [])
                    for der in chain_ders:
                        c = describe_certificate(der, role='intermedio')
                        if ca_fingerprints and c.get('fingerprint_sha256') in ca_fingerprints:
                            c['role'] = 'raiz_de_confianza (no enviada por el cliente)'
                        chain_info.append(c)

                    # Veredicto openssl verify contra la CA configurada
                    if self.server_config and self.server_config.get('ca_cert_file'):
                        client_cert_info['openssl_verify'] = run_openssl_verify(
                            leaf_der, chain_ders, self.server_config['ca_cert_file'])
                else:
                    client_cert_info['present'] = False
                    client_cert_info['note'] = (
                        'No se presento certificado de cliente. '
                        'Si MTLS esta activado, la conexion deberia haber sido rechazada '
                        'por la capa SSL antes de llegar aqui.'
                    )
        except Exception as e:
            client_cert_info['present'] = False
            if hasattr(self.request, 'getpeercert'):
                client_cert_info['error'] = str(e)
            else:
                client_cert_info['note'] = 'Modo HTTP (sin TLS): no hay certificado de cliente disponible.'
        diag['client_certificate'] = client_cert_info
        diag['client_certificate_chain'] = chain_info

        # ---- Bloque C: Peticion HTTP ----
        http_info = {}

        # Metodo, path, version HTTP
        http_info['method'] = self.command
        http_info['path'] = self.path
        http_info['request_version'] = self.request_version

        # Parsear query string
        parsed = urlparse.urlparse(self.path)
        http_info['path_only'] = parsed.path
        http_info['query_string'] = parsed.query
        if parsed.query:
            http_info['query_params'] = dict(urlparse.parse_qsl(parsed.query))
        else:
            http_info['query_params'] = {}

        # Headers (convertir a dict simple, los nombres en lowercase para consistencia)
        headers = {}
        for key, value in self.headers.items():
            headers[key.lower()] = value
        http_info['headers'] = headers

        # Client address
        http_info['client_ip'] = self.client_address[0]
        http_info['client_port'] = self.client_address[1]

        # Body
        content_length = int(headers.get('content-length', 0))
        body = b''
        if content_length > 0:
            body = self.rfile.read(content_length)
        http_info['body_size_bytes'] = len(body)
        http_info['body_is_text'] = is_text(body)
        if body:
            if is_text(body):
                try:
                    http_info['body_text'] = to_str(body)
                except Exception:
                    http_info['body_text'] = repr(body)
            else:
                http_info['body_hexdump'] = hex_dump(body)
                http_info['body_base64'] = b64encode(body)

        # Content type
        http_info['content_type'] = headers.get('content-type', '(no especificado)')
        http_info['user_agent'] = headers.get('user-agent', '(no especificado)')

        diag['http'] = http_info

        # ---- Bloque D: Variables de entorno ----
        env_info = {}
        all_env = {}
        relevant_env = {}

        for key, value in sorted(os.environ.items()):
            all_env[key] = value
            # Marcar como relevante si coincide con los prefijos conocidos
            for prefix in RELEVANT_ENV_PREFIXES:
                if key.upper().startswith(prefix.upper()):
                    relevant_env[key] = value
                    break

        env_info['all'] = all_env
        env_info['relevant'] = relevant_env
        env_info['total_count'] = len(all_env)
        env_info['relevant_count'] = len(relevant_env)
        diag['environment'] = env_info

        return diag

    def respond(self, diag):
        """Envia una respuesta HTML con el resumen del diagnostico."""
        html_str = self.build_html_response(diag)
        body = to_bytes(html_str)
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

