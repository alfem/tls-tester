def build_server_context(cert_file, key_file, ca_cert_file, cert_reqs):
    """
    Construye el SSLContext de servidor (solo Python 3).
    El certificado de cliente solo se VALIDA si se configuro una CA
    (load_verify_locations) y el verify_mode lo exige.
    """
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(cert_file, keyfile=key_file)
    if ca_cert_file:
        context.load_verify_locations(ca_cert_file)
    context.verify_mode = cert_reqs
    return context


def wrap_accepted_socket(sock, ssl_config, context=None):
    """
    Envuelve un socket YA ACEPTADO con SSL/TLS SIN iniciar el handshake
    (do_handshake_on_connect=False). El handshake se ejecutara despues, de
    forma explicita y con timeout, en el hilo del handler, para poder
    diagnosticar los fallos de certificados/CA.
    """
    if PY3:
        if context is None:
            context = build_server_context(
                ssl_config['cert_file'],
                ssl_config['key_file'],
                ssl_config.get('ca_cert_file'),
                ssl_config.get('cert_reqs', ssl.CERT_NONE),
            )
        return context.wrap_socket(sock, server_side=True, do_handshake_on_connect=False)
    else:
        # Python 2.7: usar ssl.wrap_socket() (API legacy)
        return ssl.wrap_socket(
            sock,
            server_side=True,
            certfile=ssl_config['cert_file'],
            keyfile=ssl_config['key_file'],
            ca_certs=ssl_config.get('ca_cert_file'),
            cert_reqs=ssl_config.get('cert_reqs', ssl.CERT_NONE),
            ssl_version=ssl.PROTOCOL_SSLv23,
            do_handshake_on_connect=False,
        )


