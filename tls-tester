    def save_diagnostics_json(self, diag):
        """Guarda el diagnostico como JSON en el directorio de salida."""
        output_dir = self.server_config.get('output_dir')
        if not output_dir:
            return
        try:
            # Contar peticiones existentes
            existing = [f for f in os.listdir(output_dir) if f.startswith('request_') and f.endswith('.json')]
            count = len(existing) + 1
            filename = 'request_{:04d}.json'.format(count)
            filepath = os.path.join(output_dir, filename)

            # Serializar a JSON
            serializable = self._make_json_safe(diag)
            json_str = json.dumps(serializable, indent=2, sort_keys=True, ensure_ascii=False)
            with open(filepath, 'w') as f:
                f.write(to_str(json_str))
            print('[{}] JSON guardado en {}'.format(
                datetime.datetime.now().strftime('%H:%M:%S'), filepath), file=sys.stderr)
        except Exception as e:
            print('[{}] ERROR al guardar JSON: {}'.format(
                datetime.datetime.now().strftime('%H:%M:%S'), e), file=sys.stderr)

    @staticmethod
    def _make_json_safe(obj):
        """Convierte recursivamente un objeto a tipos serializables JSON."""
        if isinstance(obj, dict):
            return {str(k): DiagnosticHandler._make_json_safe(v) for k, v in obj.items()}
        elif isinstance(obj, (list, tuple)):
            return [DiagnosticHandler._make_json_safe(item) for item in obj]
        elif isinstance(obj, bytes):
            return obj.decode('utf-8', errors='replace')
        elif isinstance(obj, STRING_TYPES):
            return to_str(obj)
        elif isinstance(obj, INTEGER_TYPES):
            return int(obj)
        elif isinstance(obj, float):
            return obj
        elif isinstance(obj, bool):
            return obj
        elif obj is None:
            return None
        else:
            return str(obj)


def _row(key, value):
    """Helper para generar filas de tabla HTML."""
    return '<tr><td><strong>{}</strong></td><td>{}</td></tr>\n'.format(
        str(key), str(value))


