def get_socket_errno(exc):
    """Extrae el errno de una excepcion de socket (compatible Py2/Py3)."""
    if hasattr(exc, 'errno') and exc.errno is not None:
        return exc.errno
    # En Python 3, errno puede estar en args[0]
    if hasattr(exc, 'args') and len(exc.args) > 0:
        return exc.args[0]
    return None


def main():
    parser = argparse.ArgumentParser(
        description='tls-tester — Servidor HTTPS/MTLS para diagnostico de conexiones TLS',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent('''\
            Ejemplos:
              %(prog)s --port 8443
              %(prog)s --port 8443 --http
              %(prog)s --port 8443 --no-mtls
              %(prog)s --port 8443 --cert server.pem --key server.key --ca-cert ca.pem
              %(prog)s --port 8443 --ca-cert ca.pem --output-dir ./logs
              %(prog)s --port 443 --cert /etc/ssl/certs/server.pem --key /etc/ssl/private/server.key --ca-cert /etc/ssl/certs/ca.pem --show-pem
        ''')
    )

    parser.add_argument('--port', '-p', type=int, default=8443,
                        help='Puerto de escucha (default: 8443)')
    parser.add_argument('--cert', '-c', type=str, default=None,
                        help='Fichero del certificado del servidor en formato PEM')
    parser.add_argument('--key', '-k', type=str, default=None,
                        help='Fichero de la clave privada del servidor en formato PEM')
    parser.add_argument('--ca-cert', '-a', type=str, default=None,
                        help='Fichero CA para validar certificados de cliente (PEM). '
                             'Si no se especifica y --no-mtls no esta activo, '
                             'se genera un aviso.')
    parser.add_argument('--no-mtls', action='store_true', default=False,
                        help='Desactiva la validacion de certificado de cliente (solo HTTPS)')
    parser.add_argument('--http', action='store_true', default=False,
                        help='Usar HTTP simple sin TLS (util detras de proxies que terminan SSL)')
    parser.add_argument('--output-dir', '-o', type=str, default=None,
                        help='Directorio donde guardar los diagnosticos como JSON')
    parser.add_argument('--show-pem', action='store_true', default=False,
                        help='Mostrar el certificado del cliente en formato PEM en la salida')
    parser.add_argument('--save-cert', type=str, default=None,
                        help='Guardar el certificado autofirmado del servidor en el fichero indicado '
                             '(util para instalarlo en el almacen de confianza del proxy/navegador)')

    args = parser.parse_args()

    # -----------------------------------------------------------------------
    # Validar argumentos
    # -----------------------------------------------------------------------

    # Determinar si MTLS esta activo
    mtls_enabled = not args.no_mtls
    http_mode = args.http

    # En modo HTTP no necesitamos certificados
    cert_file = args.cert
    key_file = args.key
    ca_cert_file = args.ca_cert
    self_signed = False
    tmpdir = None

    if not http_mode:
        if not cert_file or not key_file:
            # Generar certificado autofirmado
            if check_openssl():
                tmpdir = tempfile.mkdtemp(prefix='tls_tester_')
                atexit.register(lambda d=tmpdir: shutil.rmtree(d, ignore_errors=True))
                print('[+] Generando certificado autofirmado temporal...', file=sys.stderr)
                try:
                    cert_file, key_file = generate_self_signed_cert(tmpdir)
                    self_signed = True
                    print('[+] Certificado generado: {}'.format(cert_file), file=sys.stderr)
                    print('[+] Clave generada:      {}'.format(key_file), file=sys.stderr)
                except Exception as e:
                    print('ERROR: No se pudo generar el certificado autofirmado: {}'.format(e),
                          file=sys.stderr)
                    print('Asegurese de que openssl esta instalado o use --cert y --key.',
                          file=sys.stderr)
                    sys.exit(1)
            else:
                print('ERROR: No se proporcionaron --cert/--key y openssl no esta disponible.',
                      file=sys.stderr)
                print('Instale openssl o proporcione los ficheros de certificado con --cert y --key.',
                      file=sys.stderr)
                sys.exit(1)
        else:
            # Verificar que los ficheros existen
            for fpath, label in [(cert_file, 'Certificado'), (key_file, 'Clave privada')]:
                if not os.path.isfile(fpath):
                    print('ERROR: {} no encontrado: {}'.format(label, fpath), file=sys.stderr)
                    sys.exit(1)

        # Verificar CA cert si MTLS esta activo
        if mtls_enabled and not ca_cert_file:
            print('ADVERTENCIA: MTLS activado pero no se proporciono --ca-cert.', file=sys.stderr)
            print('Las conexiones de clientes SIN certificado seran rechazadas por SSL.', file=sys.stderr)
            print('Para aceptar cualquier certificado de cliente sin validar, use un CA "comodin"', file=sys.stderr)
            print('o desactive MTLS con --no-mtls.', file=sys.stderr)
            print('', file=sys.stderr)

        if ca_cert_file and not os.path.isfile(ca_cert_file):
            print('ERROR: CA cert no encontrado: {}'.format(ca_cert_file), file=sys.stderr)
            sys.exit(1)

    # Directorio de salida JSON
    output_dir = args.output_dir
    if output_dir:
        if not os.path.isdir(output_dir):
            try:
                os.makedirs(output_dir)
                print('[+] Directorio de salida creado: {}'.format(output_dir), file=sys.stderr)
            except Exception as e:
                print('ERROR: No se pudo crear el directorio de salida: {}'.format(e), file=sys.stderr)
                sys.exit(1)
        print('[+] Diagnosticos JSON en: {}'.format(output_dir), file=sys.stderr)

    # -----------------------------------------------------------------------
    # Configuracion SSL / HTTP
    # -----------------------------------------------------------------------

    if http_mode:
        mtls_mode = 'HTTP plano (sin TLS)'
        cert_reqs = ssl.CERT_NONE
    elif mtls_enabled:
        cert_reqs = ssl.CERT_REQUIRED
        mtls_mode = 'mTLS (certificado de cliente REQUERIDO)'
    else:
        cert_reqs = ssl.CERT_NONE
        mtls_mode = 'HTTPS (sin validar cliente)'

    ssl_config = {
        'cert_file': cert_file,
        'key_file': key_file,
        'ca_cert_file': ca_cert_file,
        'cert_reqs': cert_reqs,
        'mtls': mtls_enabled,
        'mtls_mode': mtls_mode,
        'self_signed': self_signed,
        'show_pem': args.show_pem,
        'output_dir': output_dir,
        'http_mode': http_mode,
    }

    # -----------------------------------------------------------------------
    # Guardar certificado autofirmado si se solicito
    # -----------------------------------------------------------------------

    saved_cert_path = None
    if self_signed and args.save_cert:
        try:
            shutil.copy(cert_file, args.save_cert)
            saved_cert_path = os.path.abspath(args.save_cert)
            print('[+] Certificado autofirmado guardado en: {}'.format(saved_cert_path),
                  file=sys.stderr)
        except Exception as e:
            print('ERROR: No se pudo guardar el certificado: {}'.format(e), file=sys.stderr)

    # -----------------------------------------------------------------------
    # Iniciar servidor
    # -----------------------------------------------------------------------

    server_address = ('0.0.0.0', args.port)

    print('=' * 78, file=sys.stderr)
    print('  tls-tester — TLS/MTLS Diagnostic Server', file=sys.stderr)
    print('=' * 78, file=sys.stderr)
    print('  Puerto      : {}'.format(args.port), file=sys.stderr)
    print('  Modo        : {}'.format(mtls_mode), file=sys.stderr)
    if not http_mode:
        print('  MTLS        : {}'.format('ACTIVADO' if mtls_enabled else 'DESACTIVADO'), file=sys.stderr)
        print('  Cert. serv  : {}'.format(cert_file), file=sys.stderr)
        print('  Clave serv  : {}'.format(key_file), file=sys.stderr)
        if ca_cert_file:
            print('  CA cert     : {}'.format(ca_cert_file), file=sys.stderr)
        else:
            print('  CA cert     : (no especificado)', file=sys.stderr)
        if self_signed:
            print('', file=sys.stderr)
            print('  *** ATENCION: Certificado AUTOFIRMADO ***', file=sys.stderr)
            print('', file=sys.stderr)
            print('  Si un proxy o navegador rechaza la conexion con', file=sys.stderr)
            print('  SSL_ERROR_UNKNOWN_CA_ALERT, el certificado del servidor', file=sys.stderr)
            print('  no es de confianza. Soluciones:', file=sys.stderr)
            print('', file=sys.stderr)
            print('  1. Usar --http si hay un proxy que termina TLS', file=sys.stderr)
            print('  2. Usar --save-cert fichero.pem para exportar el', file=sys.stderr)
            print('     certificado e instalarlo en el almacen de confianza', file=sys.stderr)
            print('     del proxy/navegador:', file=sys.stderr)
            if saved_cert_path:
                print('       Certificado guardado en: {}'.format(saved_cert_path), file=sys.stderr)
            else:
                print('       Ejecuta con: --save-cert /ruta/donde/guardar.pem', file=sys.stderr)
            print('       Luego instalalo con (Linux):', file=sys.stderr)
            print('         sudo cp fichero.pem /usr/local/share/ca-certificates/tls-tester.crt', file=sys.stderr)
            print('         sudo update-ca-certificates', file=sys.stderr)
            print('  3. Usar --cert y --key con un certificado firmado por', file=sys.stderr)
            print('     la CA corporativa (el mismo que usaba Apache)', file=sys.stderr)
            print('', file=sys.stderr)
    if output_dir:
        print('  Salida JSON : {}'.format(output_dir), file=sys.stderr)
    print('  Hostname    : {}'.format(socket.gethostname()), file=sys.stderr)
    print('  PID         : {}'.format(os.getpid()), file=sys.stderr)
    print('  Python      : {}'.format(python_version_string()), file=sys.stderr)
    print('  OpenSSL     : {}'.format(ssl.OPENSSL_VERSION), file=sys.stderr)
    print('', file=sys.stderr)
    print('  URLs de prueba:', file=sys.stderr)
    if http_mode:
        print('    http://localhost:{}/'.format(args.port), file=sys.stderr)
        print('    http://{}:{}/'.format(socket.gethostname(), args.port), file=sys.stderr)
        print('    curl http://localhost:{}/'.format(args.port), file=sys.stderr)
    else:
        print('    https://localhost:{}/'.format(args.port), file=sys.stderr)
        print('    https://{}:{}/'.format(socket.gethostname(), args.port), file=sys.stderr)
        if mtls_enabled:
            print('    curl -k --cert client.pem --key client.key https://localhost:{}/'.format(args.port), file=sys.stderr)
        else:
            print('    curl -k https://localhost:{}/'.format(args.port), file=sys.stderr)
    print('', file=sys.stderr)
    print('  Ctrl+C para detener', file=sys.stderr)
    print('=' * 78, file=sys.stderr)
    print('', file=sys.stderr)

    # Pasar configuracion al handler
    DiagnosticHandler.server_config = ssl_config

    try:
        if http_mode:
            # Modo HTTP simple — sin SSL
            server = ThreadingMTLSServer(
                server_address, DiagnosticHandler, ssl_config,
                use_ssl=False
            )
        else:
            server = ThreadingMTLSServer(server_address, DiagnosticHandler, ssl_config)
    except ssl.SSLError as e:
        print('ERROR SSL: {}'.format(e), file=sys.stderr)
        print('Verifique que los ficheros de certificado son validos.', file=sys.stderr)
        sys.exit(1)
    except socket.error as e:
        errno = get_socket_errno(e)
        if errno == 13:
            print('ERROR: Permiso denegado al abrir el puerto {}.'.format(args.port), file=sys.stderr)
            print('Use un puerto > 1024 o ejecute con privilegios de root.', file=sys.stderr)
        elif errno == 48 or errno == 98:
            print('ERROR: El puerto {} ya esta en uso.'.format(args.port), file=sys.stderr)
            print('Use otro puerto con --port o detenga el proceso que lo ocupa.', file=sys.stderr)
        else:
            print('ERROR de socket ({}) : {}'.format(errno, e), file=sys.stderr)
        sys.exit(1)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print('\n[+] Apagando servidor...', file=sys.stderr)
        server.shutdown()
        server.server_close()
        print('[+] Servidor detenido.', file=sys.stderr)
        sys.exit(0)


if __name__ == '__main__':
    main()
