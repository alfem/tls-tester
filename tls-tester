class ThreadingMTLSServer(SocketServer.ThreadingMixIn, BaseHTTPServer.HTTPServer):
    """Servidor HTTPS con soporte multihilo y MTLS."""
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, server_address, handler_class, ssl_config, use_ssl=True):
        BaseHTTPServer.HTTPServer.__init__(self, server_address, handler_class)
        self.ssl_config = ssl_config

        if use_ssl:
            # Envolver el socket con SSL (compatible Py2/Py3)
            try:
                self.socket = wrap_socket_ssl(
                    self.socket,
                    cert_file=ssl_config['cert_file'],
                    key_file=ssl_config['key_file'],
                    ca_cert_file=ssl_config.get('ca_cert_file'),
                    cert_reqs=ssl_config.get('cert_reqs', ssl.CERT_NONE),
                )
            except ssl.SSLError as e:
                print('ERROR SSL al configurar el socket: {}'.format(e), file=sys.stderr)
                raise
            except Exception as e:
                print('ERROR al configurar SSL: {}'.format(e), file=sys.stderr)
                raise
        # else: socket sin SSL (HTTP plano)


