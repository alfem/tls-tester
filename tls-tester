def to_bytes(s):
    """Convierte str/unicode a bytes de forma compatible con Py2 y Py3."""
    if isinstance(s, bytes):
        return s
    return s.encode('utf-8')


def to_str(s):
    """Convierte bytes/unicode a str nativo de forma compatible."""
    if isinstance(s, str) and not isinstance(s, bytes):
        return s
    if isinstance(s, bytes):
        return s.decode('utf-8', errors='replace')
    return str(s) if PY3 else unicode(s)


def b64encode(data):
    """Codifica bytes a base64 (string) compatible Py2/Py3."""
    raw = base64.b64encode(data)
    if PY3:
        return raw.decode('ascii')
    return raw


def is_text(data):
    """Detecta si un buffer es texto imprimible o binario."""
    if not data:
        return True
    # Si mas del 5% son bytes no imprimibles, lo consideramos binario
    non_printable = sum(1 for b in bytearray(data) if b < 0x20 and b not in (0x09, 0x0A, 0x0D))
    return non_printable <= len(data) * 0.05


def hex_dump(data, width=16):
    """Devuelve un hexdump al estilo xxd."""
    lines = []
    for i in range(0, len(data), width):
        chunk = data[i:i+width]
        hex_part = ' '.join('{:02x}'.format(b) for b in bytearray(chunk))
        ascii_part = ''.join(chr(b) if 32 <= b < 127 else '.' for b in bytearray(chunk))
        lines.append('  {:08x}  {:48s}  |{}|'.format(i, hex_part, ascii_part))
    return '\n'.join(lines)


def format_rdn(rdn_tuple):
    """
    Convierte un RDN de formato ssl (tupla de tuplas) a string legible.
    Ejemplo: ((('commonName', 'foo'),), (('organizationName', 'bar'),))
      -> "CN=foo, O=bar"
    """
    if not rdn_tuple:
        return '(no disponible)'
    oid_map = {
        'commonName': 'CN',
        'organizationName': 'O',
        'organizationalUnitName': 'OU',
        'countryName': 'C',
        'stateOrProvinceName': 'ST',
        'localityName': 'L',
        'emailAddress': 'emailAddress',
        'domainComponent': 'DC',
        'streetAddress': 'street',
        'postalCode': 'postalCode',
        'serialNumber': 'serialNumber',
        'surname': 'SN',
        'givenName': 'GN',
        'title': 'title',
        'description': 'description',
        'userId': 'UID',
        'businessCategory': 'businessCategory',
        'jurisdictionCountryName': 'jurisdictionC',
        'jurisdictionStateOrProvinceName': 'jurisdictionST',
        'jurisdictionLocalityName': 'jurisdictionL',
    }
    parts = []
    for rdn in rdn_tuple:
        for attr in rdn:
            key = attr[0]
            value = attr[1]
            short = oid_map.get(key, key)
            parts.append('{}={}'.format(short, value))
    return ', '.join(parts)


def format_datetime(s):
    """Formatea una fecha ASN.1 a formato legible."""
    if not s:
        return '(no disponible)'
    try:
        # Formato ASN.1 GENERALIZEDTIME: YYYYMMDDHHMMSSZ
        if s.endswith('Z'):
            s = s[:-1]
        if len(s) >= 14:
            dt = datetime.datetime.strptime(s[:14], '%Y%m%d%H%M%S')
            return dt.strftime('%Y-%m-%d %H:%M:%S UTC')
    except (ValueError, Exception):
        pass
    return s


def days_remaining(not_after_str):
    """Calcula los dias restantes hasta la fecha de expiracion."""
    if not not_after_str:
        return None
    try:
        s = not_after_str
        if s.endswith('Z'):
            s = s[:-1]
        if len(s) >= 14:
            dt = datetime.datetime.strptime(s[:14], '%Y%m%d%H%M%S')
            remaining = (dt - utcnow()).total_seconds() / 86400.0
            return int(remaining)
    except (ValueError, Exception):
        pass
    return None


def extract_sans(cert):
    """Extrae los Subject Alternative Names del certificado."""
    sans = []
    # subjectAltName: tuple of (type, value)
    alt_name = cert.get('subjectAltName', ())
    if alt_name:
        for entry in alt_name:
            # entry es (type, value) donde type es 'DNS', 'IP Address', etc.
            if len(entry) == 2:
                sans.append('{}: {}'.format(entry[0], entry[1]))
            else:
                sans.append(str(entry))
    return sans


def cert_fingerprint(der_data, algo='sha1'):
    """Calcula la huella del certificado."""
    if algo == 'sha1':
        h = hashlib.sha1(der_data).hexdigest()
    elif algo == 'sha256':
        h = hashlib.sha256(der_data).hexdigest()
    else:
        return 'algoritmo desconocido'
    # Formatear con dos puntos
    return ':'.join(h[i:i+2].upper() for i in range(0, len(h), 2))


