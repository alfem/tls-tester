            sys.version_info.major, sys.version_info.minor, sys.version_info.micro)
        html += '</body></html>'
        return html

    def do_GET(self):
        """Maneja peticiones GET."""
        self._handle_request()

    def do_POST(self):
        """Maneja peticiones POST."""
        self._handle_request()

    def do_PUT(self):
        """Maneja peticiones PUT."""
        self._handle_request()

    def do_DELETE(self):
        """Maneja peticiones DELETE."""
        self._handle_request()

    def do_HEAD(self):
        """Maneja peticiones HEAD."""
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()

    def do_OPTIONS(self):
        """Maneja peticiones OPTIONS."""
        self.send_response(200)
        self.send_header('Allow', 'GET, POST, PUT, DELETE, HEAD, OPTIONS')
        self.end_headers()

    def _handle_request(self):
        """Logica comun para todas las peticiones."""
        diag = None
        try:
            diag = self.collect_diagnostics()
            self.print_diagnostics(diag)
            if self.server_config and self.server_config.get('output_dir'):
                self.save_diagnostics_json(diag)
            self.respond(diag)
        except Exception as e:
            # Si algo falla, intentamos responder con un error 500
            try:
                error_body = '<h1>Error 500</h1><p>{}</p>'.format(str(e))
                if diag:
                    self.print_diagnostics(diag)
                print('\n  *** ERROR en _handle_request: {} ***\n'.format(e), file=sys.stderr)
                import traceback
                traceback.print_exc(file=sys.stderr)
                sys.stderr.flush()
                self.send_response(500)
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.send_header('Content-Length', str(len(error_body)))
                self.end_headers()
                self.wfile.write(to_bytes(error_body))
            except Exception:
                # Si incluso eso falla, cerramos sin mas
                pass

