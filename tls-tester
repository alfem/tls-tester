        print('\n  [VARIABLES DE ENTORNO]')
        print('  {} totales, {} relevantes para TLS/Java'.format(
            env_info.get('total_count', 0), env_info.get('relevant_count', 0)))

        relevant = env_info.get('relevant', {})
        if relevant:
            print('\n  --- Relevantes para MTLS / Java ---')
            for key in sorted(relevant.keys()):
                print('    {} = {}'.format(key, relevant[key]))

        print('\n  --- Todas ---')
        all_env = env_info.get('all', {})
        for key in sorted(all_env.keys()):
            print('    {} = {}'.format(key, all_env[key]))

        print('\n' + sep)
        sys.stdout.flush()

