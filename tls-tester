def generate_self_signed_cert(tmpdir):
    """
    Genera un certificado autofirmado y su clave privada usando openssl.
    Devuelve (cert_path, key_path).
    """
    key_path = os.path.join(tmpdir, 'server.key')
    cert_path = os.path.join(tmpdir, 'server.pem')

    # Generar clave privada
    subprocess.check_call(
        ['openssl', 'genrsa', '-out', key_path, '2048'],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )

    # Generar certificado autofirmado
    subprocess.check_call(
        [
            'openssl', 'req', '-new', '-x509',
            '-key', key_path,
            '-out', cert_path,
            '-days', '365',
            '-subj', '/CN=TLS-Tester-Server/O=TLS-Tester/OU=Diagnostic',
            '-nodes'
        ],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )

    return cert_path, key_path


def check_openssl():
    """Verifica que openssl esta disponible."""
    try:
        subprocess.check_call(
            ['openssl', 'version'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
        return True
    except (subprocess.CalledProcessError, OSError):
        return False


# ---------------------------------------------------------------------------
# Configuracion SSL unificada Py2 / Py3
# ---------------------------------------------------------------------------

def wrap_socket_ssl(sock, cert_file, key_file, ca_cert_file, cert_reqs):
    """
    Envuelve un socket con SSL/TLS de forma compatible con Python 2 y 3.
    En Python 3 usa SSLContext; en Python 2 usa ssl.wrap_socket().
    """
    if PY3:
        # Python 3: usar SSLContext (API moderna)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(cert_file, keyfile=key_file)
        if ca_cert_file:
            context.load_verify_locations(ca_cert_file)
        context.verify_mode = cert_reqs
        # Permitir que el cliente envie certificado incluso si no es obligatorio
        if cert_reqs == ssl.CERT_NONE:
            context.verify_mode = ssl.CERT_OPTIONAL
            # Nota: CERT_OPTIONAL pide certificado pero no falla si no lo presenta.
            # Usamos esto en modo no-mtls para poder inspeccionar certificados
            # opcionales. Pero en modo no-mtls real, no se pide nada.
            # Volvemos a NONE si es explicitamente --no-mtls
        return context.wrap_socket(sock, server_side=True)
    else:
        # Python 2.7: usar ssl.wrap_socket() (API legacy)
        ssl_version = ssl.PROTOCOL_SSLv23
        return ssl.wrap_socket(
            sock,
            server_side=True,
            certfile=cert_file,
            keyfile=key_file,
            ca_certs=ca_cert_file,
            cert_reqs=cert_reqs,
            ssl_version=ssl_version,
        )


# ---------------------------------------------------------------------------
# Handler HTTP
# ---------------------------------------------------------------------------

class DiagnosticHandler(BaseHTTPServer.BaseHTTPRequestHandler):
    """
    Handler HTTP que recopila y muestra toda la informacion de diagnostico
    sobre cada peticion entrante.
    """

    # Referencia al servidor padre para acceder a la configuracion
    server_config = None

    def log_message(self, format, *args):
        """Redirigimos el log del handler a stderr."""
        print('[{}] {}'.format(
            datetime.datetime.now().strftime('%H:%M:%S'),
            format % args
        ), file=sys.stderr)

    def collect_diagnostics(self):
        """Recopila toda la informacion de diagnostico y la devuelve como dict."""
        diag = {}
        now = utcnow()

        # ---- Bloque E: Informacion del servidor ----
        diag['server'] = {
            'timestamp': now.strftime('%Y-%m-%d %H:%M:%S UTC'),
            'timestamp_iso': now.isoformat() + 'Z',
            'hostname': socket.gethostname(),
            'pid': os.getpid(),
            'port': self.server.server_port,
            'python_version': sys.version,
            'python_short': '{}.{}.{}'.format(
                sys.version_info.major,
                sys.version_info.minor,
                sys.version_info.micro,
            ),
            'openssl_version': ssl.OPENSSL_VERSION,
        }
        if self.server_config:
            diag['server']['mtls_enabled'] = self.server_config.get('mtls', False)
            diag['server']['mtls_mode'] = self.server_config.get('mtls_mode', 'none')
            diag['server']['http_mode'] = self.server_config.get('http_mode', False)
            diag['server']['self_signed_cert'] = self.server_config.get('self_signed', False)
            if self.server_config.get('cert_file'):
                diag['server']['server_cert_file'] = self.server_config['cert_file']
            if self.server_config.get('ca_cert_file'):
                diag['server']['ca_cert_file'] = self.server_config['ca_cert_file']

        # ---- Bloque A: Informacion de conexion TLS ----
        tls_info = {}
        http_mode = self.server_config.get('http_mode', False) if self.server_config else False
        if http_mode:
            tls_info['note'] = 'Modo HTTP plano — sin cifrado TLS.'
        else:
            try:
                if hasattr(self.request, 'cipher'):
                    cipher = self.request.cipher()
                    if cipher:
                        tls_info['cipher_name'] = cipher[0]
                        tls_info['tls_version'] = cipher[1]
                        tls_info['secret_bits'] = cipher[2]
            except Exception as e:
                tls_info['cipher_error'] = str(e)
        diag['tls'] = tls_info

        # ---- Bloque B: Certificado del cliente ----
        client_cert_info = {}
        try:
            peer_cert = self.request.getpeercert()
            if peer_cert is not None and len(peer_cert) > 0:
                client_cert_info['present'] = True

                # Subject
                client_cert_info['subject'] = format_rdn(peer_cert.get('subject'))
                client_cert_info['subject_raw'] = peer_cert.get('subject')

                # Issuer
                client_cert_info['issuer'] = format_rdn(peer_cert.get('issuer'))
                client_cert_info['issuer_raw'] = peer_cert.get('issuer')

                # Numero de serie
                client_cert_info['serial_number'] = peer_cert.get('serialNumber', '(no disponible)')

                # Validez
                not_before = peer_cert.get('notBefore', '')
                not_after = peer_cert.get('notAfter', '')
                client_cert_info['not_before'] = format_datetime(not_before)
                client_cert_info['not_after'] = format_datetime(not_after)
                client_cert_info['days_remaining'] = days_remaining(not_after)

                # ¿Expirado?
                remaining_days = days_remaining(not_after)
                client_cert_info['expired'] = (
                    remaining_days is not None and remaining_days < 0
                )
                # ¿Aun no valido?
                remaining_not_before = None
                if not_before:
                    try:
                        s_val = not_before
                        if s_val.endswith('Z'):
                            s_val = s_val[:-1]
                        if len(s_val) >= 14:
                            dt_nb = datetime.datetime.strptime(s_val[:14], '%Y%m%d%H%M%S')
                            remaining_not_before = int(
                                (dt_nb - utcnow()).total_seconds() / 86400.0
                            )
                    except (ValueError, Exception):
                        pass
                client_cert_info['not_yet_valid'] = (
                    remaining_not_before is not None and remaining_not_before > 0
                )

                # SANs
                client_cert_info['subject_alt_names'] = extract_sans(peer_cert)

                # OCSP
                client_cert_info['ocsp_responders'] = peer_cert.get('OCSP', [])

                # caIssuers
                client_cert_info['ca_issuers'] = peer_cert.get('caIssuers', [])

                # crlDistributionPoints
                client_cert_info['crl_distribution_points'] = peer_cert.get('crlDistributionPoints', [])

                # Key usage / Extended key usage
                client_cert_info['key_usage'] = peer_cert.get('keyUsage', '(no disponible)')
                client_cert_info['extended_key_usage'] = peer_cert.get('extendedKeyUsage', '(no disponible)')

                # Algoritmo de firma
                client_cert_info['signature_algorithm'] = peer_cert.get('signatureAlgorithm', '(no disponible)')

                # Tamano de clave publica (intentamos deducirlo)
                client_cert_info['public_key_size_bits'] = peer_cert.get('publicKeySize', '(no disponible)')

                # version
                client_cert_info['version'] = peer_cert.get('version', '(no disponible)')

                # Huellas (fingerprints) — desde DER binario
                try:
                    der_data = self.request.getpeercert(binary_form=True)
                    if der_data:
                        client_cert_info['fingerprint_sha1'] = cert_fingerprint(der_data, 'sha1')
                        client_cert_info['fingerprint_sha256'] = cert_fingerprint(der_data, 'sha256')
                        client_cert_info['der_size_bytes'] = len(der_data)
                except Exception as e:
                    client_cert_info['fingerprint_error'] = str(e)

                # PEM (si esta habilitado)
                if self.server_config and self.server_config.get('show_pem'):
                    try:
                        der_data_pem = self.request.getpeercert(binary_form=True)
                        if der_data_pem:
                            client_cert_info['pem'] = ssl.DER_cert_to_PEM_cert(der_data_pem)
                    except Exception as e:
                        client_cert_info['pem_error'] = str(e)

            else:
                client_cert_info['present'] = False
                client_cert_info['note'] = (
                    'No se presento certificado de cliente. '
                    'Si MTLS esta activado, la conexion deberia haber sido rechazada '
                    'por la capa SSL antes de llegar aqui.'
                )
        except Exception as e:
            client_cert_info['present'] = False
            if hasattr(self.request, 'getpeercert'):
                client_cert_info['error'] = str(e)
            else:
                client_cert_info['note'] = 'Modo HTTP (sin TLS): no hay certificado de cliente disponible.'
        diag['client_certificate'] = client_cert_info

        # ---- Bloque C: Peticion HTTP ----
        http_info = {}

        # Metodo, path, version HTTP
        http_info['method'] = self.command
        http_info['path'] = self.path
        http_info['request_version'] = self.request_version

        # Parsear query string
        parsed = urlparse.urlparse(self.path)
        http_info['path_only'] = parsed.path
        http_info['query_string'] = parsed.query
        if parsed.query:
            http_info['query_params'] = dict(urlparse.parse_qsl(parsed.query))
        else:
            http_info['query_params'] = {}

        # Headers (convertir a dict simple, los nombres en lowercase para consistencia)
        headers = {}
        for key, value in self.headers.items():
            headers[key.lower()] = value
        http_info['headers'] = headers

        # Client address
        http_info['client_ip'] = self.client_address[0]
        http_info['client_port'] = self.client_address[1]

        # Body
        content_length = int(headers.get('content-length', 0))
        body = b''
        if content_length > 0:
            body = self.rfile.read(content_length)
        http_info['body_size_bytes'] = len(body)
        http_info['body_is_text'] = is_text(body)
        if body:
            if is_text(body):
                try:
                    http_info['body_text'] = to_str(body)
                except Exception:
                    http_info['body_text'] = repr(body)
            else:
                http_info['body_hexdump'] = hex_dump(body)
                http_info['body_base64'] = b64encode(body)

        # Content type
        http_info['content_type'] = headers.get('content-type', '(no especificado)')
        http_info['user_agent'] = headers.get('user-agent', '(no especificado)')

        diag['http'] = http_info

        # ---- Bloque D: Variables de entorno ----
        env_info = {}
        all_env = {}
        relevant_env = {}

        for key, value in sorted(os.environ.items()):
            all_env[key] = value
            # Marcar como relevante si coincide con los prefijos conocidos
            for prefix in RELEVANT_ENV_PREFIXES:
                if key.upper().startswith(prefix.upper()):
                    relevant_env[key] = value
                    break

        env_info['all'] = all_env
        env_info['relevant'] = relevant_env
        env_info['total_count'] = len(all_env)
        env_info['relevant_count'] = len(relevant_env)
        diag['environment'] = env_info

        return diag

    def respond(self, diag):
        """Envia una respuesta HTML con el resumen del diagnostico."""
        html_str = self.build_html_response(diag)
        body = to_bytes(html_str)
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

