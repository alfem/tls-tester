class ThreadingMTLSServer(SocketServer.ThreadingMixIn, BaseHTTPServer.HTTPServer):
    """Servidor HTTPS con soporte multihilo y MTLS.

    El socket de escucha NO se envuelve con SSL: cada conexion aceptada se
    envuelve en get_request() con do_handshake_on_connect=False, y el
    handshake se ejecuta de forma explicita (con timeout) en el handler.
    Asi un fallo de handshake se diagnostica en lugar de perderse, y un
    cliente que conecta sin hablar TLS no bloquea el bucle de aceptacion.
    """
    allow_reuse_address = True
    daemon_threads = True

    def __init__(self, server_address, handler_class, ssl_config, use_ssl=True):
        BaseHTTPServer.HTTPServer.__init__(self, server_address, handler_class)
        self.ssl_config = ssl_config
        self.use_ssl = use_ssl
        self._ssl_context = None

        if use_ssl and PY3:
            # Construir el SSLContext una sola vez (Python 3)
            try:
                self._ssl_context = build_server_context(
                    ssl_config['cert_file'],
                    ssl_config['key_file'],
                    ssl_config.get('ca_cert_file'),
                    ssl_config.get('cert_reqs', ssl.CERT_NONE),
                )
            except ssl.SSLError as e:
                print('ERROR SSL al configurar el socket: {}'.format(e), file=sys.stderr)
                raise
            except Exception as e:
                print('ERROR al configurar SSL: {}'.format(e), file=sys.stderr)
                raise
        # else: socket sin SSL (HTTP plano)

    def get_request(self):
        """Acepta la conexion y la envuelve con TLS SIN iniciar el handshake."""
        sock, addr = self.socket.accept()
        if self.use_ssl:
            try:
                sock = wrap_accepted_socket(sock, self.ssl_config, self._ssl_context)
            except Exception as e:
                print('ERROR al envolver el socket aceptado con SSL: {}'.format(e), file=sys.stderr)
                sock.close()
                raise
        return sock, addr

    def handle_error(self, request, client_address):
        """Fallo de handshake TLS: informe estructurado. El resto: comportamiento por defecto."""
        diag = getattr(request, '_tls_handshake_diag', None)
        if diag is not None:
            try:
                report_handshake_failure(diag, self.ssl_config)
            except Exception:
                pass
        else:
            SocketServer.BaseServer.handle_error(self, request, client_address)


