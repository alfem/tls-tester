def generate_self_signed_cert(tmpdir):
    """
    Genera un certificado autofirmado y su clave privada usando openssl.
    Devuelve (cert_path, key_path).
    """
    key_path = os.path.join(tmpdir, 'server.key')
    cert_path = os.path.join(tmpdir, 'server.pem')

    # Generar clave privada
    subprocess.check_call(
        ['openssl', 'genrsa', '-out', key_path, '2048'],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )

    # Generar certificado autofirmado (con SANs si openssl >= 1.1.1)
    cmd = [
        'openssl', 'req', '-new', '-x509',
        '-key', key_path,
        '-out', cert_path,
        '-days', '365',
        '-subj', '/CN=TLS-Tester-Server/O=TLS-Tester/OU=Diagnostic',
        '-nodes'
    ]
    if openssl_version_tuple() >= (1, 1, 1):
        try:
            hostname = socket.gethostname()
        except Exception:
            hostname = 'localhost'
        cmd += [
            '-addext', 'subjectAltName=DNS:localhost,DNS:{},IP:127.0.0.1'.format(hostname),
            '-addext', 'extendedKeyUsage=serverAuth'
        ]
    else:
        print('openssl < 1.1.1: certificado autofirmado SIN subjectAltName '
              '(un WAF podria rechazarlo por nombre).', file=sys.stderr)
    subprocess.check_call(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    return cert_path, key_path


def check_openssl():
    """Verifica que openssl esta disponible."""
    try:
        subprocess.check_call(
            ['openssl', 'version'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
        return True
    except (subprocess.CalledProcessError, OSError):
        return False


def openssl_version_tuple():
    """Devuelve (major, minor, patch) de la version de openssl, o (0, 0, 0)."""
    try:
        proc = subprocess.Popen(
            ['openssl', 'version'],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
        out, _ = proc.communicate()
        m = re.search(r'(\d+)\.(\d+)\.(\d+)', to_str(out))
        if m:
            return (int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except Exception:
        pass
    return (0, 0, 0)


