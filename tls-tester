            html += '<h3>Relevantes para MTLS / Java</h3><table>'
            for key in sorted(relevant.keys()):
                html += '<tr class="env-relevant"><td><strong>{}</strong></td><td><code>{}</code></td></tr>'.format(
                    str(key), str(relevant[key]))
            html += '</table>'

        # Todas
        all_env = env_info.get('all', {})
