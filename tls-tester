class TLSHandshakeFailure(Exception):
    """Excepcion interna: el handshake TLS de una conexion fallo (ya diagnosticado)."""
    pass


def pem_to_der(pem_data):
    """
    Convierte PEM a DER (bytes) tolerando las convenciones de tipos de
    cada build de Python (algunos esperan str y devuelven bytes, otros
    bytes/bytes).
    """
    for variant in (pem_data, to_bytes(pem_data), to_str(pem_data)):
        try:
            res = ssl.PEM_cert_to_DER_cert(variant)
            if res is not None:
                return to_bytes(res)
        except Exception:
            continue
    return None


def der_to_pem(der_data):
    """
    Convierte DER a PEM (bytes) tolerando las convenciones de tipos de
    cada build de Python (algunos devuelven str).
    """
    for variant in (der_data, to_bytes(der_data), to_str(der_data)):
        try:
            res = ssl.DER_cert_to_PEM_cert(variant)
            if res is not None:
                return to_bytes(res)
        except Exception:
            continue
    return None


def run_openssl(args, input_data=None):
    """Ejecuta openssl y devuelve (rc, stdout, stderr). (rc=None si no llego a ejecutarse)"""
    try:
        env = dict(os.environ)
        env['LC_ALL'] = 'C'  # salida determinista (fechas/meses en ingles)
        proc = subprocess.Popen(
            args,
            stdin=subprocess.PIPE if input_data is not None else None,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env
        )
        out, err = proc.communicate(to_bytes(input_data) if input_data is not None else None)
        return proc.returncode, to_str(out).strip(), to_str(err).strip()
    except Exception as e:
        return None, '', str(e)


def run_openssl_pipeline(cmds):
    """Ejecuta una tuberia de comandos openssl. Devuelve (rc, stdout, stderr)."""
    try:
        env = dict(os.environ)
        env['LC_ALL'] = 'C'
        procs = []
        prev_stdout = None
        for cmd in cmds:
            proc = subprocess.Popen(
                cmd,
                stdin=prev_stdout,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env
            )
            if prev_stdout is not None:
                prev_stdout.close()
            prev_stdout = proc.stdout
            procs.append(proc)
        out, err = procs[-1].communicate()
        rc = procs[-1].returncode
        for p in procs[:-1]:
            p.wait()
        return rc, to_str(out).strip(), to_str(err).strip()
    except Exception as e:
        return None, '', str(e)


def pem_cert_blocks(text):
    """Extrae los bloques PEM 'CERTIFICATE' de un fichero/buffer."""
    return re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----', to_str(text), re.S)


def _parse_openssl_date(s):
    """Parsea una fecha estilo 'Oct  2 10:00:00 2026 GMT' a datetime."""
    if not s:
        return None
    try:
        s_clean = re.sub(r'\s+', ' ', s.strip())
        return datetime.datetime.strptime(s_clean, '%b %d %H:%M:%S %Y %Z')
    except Exception:
        return None


def _format_openssl_dt(dt):
    """Formatea un datetime como el resto de fechas del informe."""
    if dt is None:
        return '(no disponible)'
    return dt.strftime('%Y-%m-%d %H:%M:%S UTC')


def _days_from_datetime(dt):
    """Dias restantes hasta un datetime (negativo si ya paso)."""
    if dt is None:
        return None
    return int((dt - utcnow()).total_seconds() / 86400.0)


def _not_yet_valid(not_before_str):
    """Determina si el certificado aun no es valido (notBefore futuro)."""
    if not not_before_str:
        return False
    try:
        s_val = not_before_str
        if s_val.endswith('Z'):
            s_val = s_val[:-1]
        if len(s_val) >= 14:
            dt_nb = datetime.datetime.strptime(s_val[:14], '%Y%m%d%H%M%S')
            remaining = int((dt_nb - utcnow()).total_seconds() / 86400.0)
            return remaining > 0
    except Exception:
        pass
    try:
        dt_nb = _parse_openssl_date(not_before_str)
        if dt_nb is not None:
            remaining = int((dt_nb - utcnow()).total_seconds() / 86400.0)
            return remaining > 0
    except Exception:
        pass
    return False


def describe_server_certificate(cert_file):
    """Describe el certificado de servidor (sujeto, emisor, SANs, validez, huellas)."""
    info = {'file': cert_file}
    rc, out, err = run_openssl(['openssl', 'x509', '-in', cert_file, '-noout',
                                '-subject', '-issuer', '-serial', '-dates',
                                '-ext', 'subjectAltName'])
    if rc != 0:
        info['error'] = err or out or 'openssl x509 fallo'
        return info
    sans = []
    in_san = False
    not_before_dt = None
    not_after_dt = None
    for line in out.splitlines():
        if line.startswith('subject='):
            info['subject'] = line[len('subject='):].strip()
        elif line.startswith('issuer='):
            info['issuer'] = line[len('issuer='):].strip()
        elif line.startswith('serial='):
            info['serial'] = line[len('serial='):].strip()
        elif line.startswith('notBefore='):
            not_before_dt = _parse_openssl_date(line[len('notBefore='):])
            info['not_before'] = _format_openssl_dt(not_before_dt)
        elif line.startswith('notAfter='):
            not_after_dt = _parse_openssl_date(line[len('notAfter='):])
            info['not_after'] = _format_openssl_dt(not_after_dt)
        elif 'Subject Alternative Name' in line:
            in_san = True
        elif in_san and line.strip():
            sans.append(line.strip())
            in_san = False
    info['subject_alt_names'] = sans
    info['days_remaining'] = _days_from_datetime(not_after_dt)
    info['expired'] = info['days_remaining'] is not None and info['days_remaining'] < 0
    if not_before_dt is not None:
        nb_days = _days_from_datetime(not_before_dt)
        info['not_yet_valid'] = nb_days is not None and nb_days > 0
    else:
        info['not_yet_valid'] = False
    # Huellas desde el DER (determinista en todas las versiones de openssl)
    try:
        with open(cert_file, 'rb') as f:
            pem_data = f.read()
        der_data = pem_to_der(pem_data)
        if der_data is not None:
            info['fingerprint_sha256'] = cert_fingerprint(der_data, 'sha256')
            info['fingerprint_sha1'] = cert_fingerprint(der_data, 'sha1')
    except Exception as e:
        info['fingerprint_error'] = str(e)
    return info


def describe_ca_bundle(ca_cert_file):
    """Describe el bundle de CA (sujeto/emisor de cada certificado)."""
    info = {
        'file': ca_cert_file,
        'count': 0,
        'certificates': [],
        'der_list': [],
        'fingerprints_sha256': [],
    }
    rc, out, err = run_openssl_pipeline([
        ['openssl', 'crl2pkcs7', '-nocrl', '-certfile', ca_cert_file],
        ['openssl', 'pkcs7', '-print_certs', '-noout'],
    ])
    if rc != 0:
        # Fallback: parsear bloque a bloque con openssl x509
        try:
            with open(ca_cert_file, 'rb') as f:
                text = to_str(f.read())
            for block in pem_cert_blocks(text):
                rc2, out2, _ = run_openssl(
                    ['openssl', 'x509', '-noout', '-subject', '-issuer'],
                    input_data=block
                )
                cert_entry = {'subject': '(no disponible)', 'issuer': '(no disponible)'}
                for line in (out2 or '').splitlines():
                    if line.startswith('subject='):
                        cert_entry['subject'] = line[len('subject='):].strip()
                    elif line.startswith('issuer='):
                        cert_entry['issuer'] = line[len('issuer='):].strip()
                info['certificates'].append(cert_entry)
                der_block = pem_to_der(block)
                if der_block is not None:
                    info['der_list'].append(der_block)
        except Exception as e:
            info['error'] = str(e)
    else:
        # Parsear las lineas subject=/issuer= del pkcs7 -print_certs
        cert_entry = None
        for line in out.splitlines():
            if line.startswith('subject='):
                cert_entry = {
                    'subject': line[len('subject='):].strip(),
                    'issuer': '(no disponible)',
                }
                info['certificates'].append(cert_entry)
            elif line.startswith('issuer=') and cert_entry is not None:
                cert_entry['issuer'] = line[len('issuer='):].strip()
    # DER list desde los bloques PEM del fichero
    try:
        with open(ca_cert_file, 'rb') as f:
            text = to_str(f.read())
        for block in pem_cert_blocks(text):
            der_block = pem_to_der(block)
            if der_block is not None:
                info['der_list'].append(der_block)
    except Exception as e:
        info['error'] = str(e)
    info['count'] = len(info['certificates'])
    info['fingerprints_sha256'] = [cert_fingerprint(d, 'sha256') for d in info['der_list']]
    return info


def _describe_cert_with_openssl(der_data):
    """Deriva los datos de un certificado ejecutando openssl x509 (sin dict de ssl)."""
    info = {
        'subject': '(no disponible)',
        'issuer': '(no disponible)',
        'serial_number': '(no disponible)',
        'not_before': '(no disponible)',
        'not_after': '(no disponible)',
        'days_remaining': None,
        'expired': False,
        'not_yet_valid': False,
        'subject_alt_names': [],
        'ocsp_responders': [],
        'ca_issuers': [],
        'crl_distribution_points': [],
        'key_usage': '(no disponible)',
        'extended_key_usage': '(no disponible)',
        'signature_algorithm': '(no disponible)',
        'public_key_size_bits': '(no disponible)',
        'version': '(no disponible)',
    }
    tmpdir = tempfile.mkdtemp(prefix='tls_tester_cert_')
    try:
        pem_bytes = der_to_pem(der_data)
        if pem_bytes is None:
            info['openssl_error'] = 'no se pudo convertir el certificado a PEM'
            return info
        pem_path = os.path.join(tmpdir, 'cert.pem')
        with open(pem_path, 'wb') as f:
            f.write(pem_bytes)
        rc, out, err = run_openssl(['openssl', 'x509', '-in', pem_path, '-noout',
                                    '-subject', '-issuer', '-serial', '-dates',
                                    '-ext', 'subjectAltName'])
        if rc != 0:
            info['openssl_error'] = err or out
            return info
        not_before_dt = None
        not_after_dt = None
        in_san = False
        for line in out.splitlines():
            if line.startswith('subject='):
                info['subject'] = line[len('subject='):].strip()
            elif line.startswith('issuer='):
                info['issuer'] = line[len('issuer='):].strip()
            elif line.startswith('serial='):
                info['serial_number'] = line[len('serial='):].strip()
            elif line.startswith('notBefore='):
                not_before_dt = _parse_openssl_date(line[len('notBefore='):])
                info['not_before'] = _format_openssl_dt(not_before_dt)
            elif line.startswith('notAfter='):
                not_after_dt = _parse_openssl_date(line[len('notAfter='):])
                info['not_after'] = _format_openssl_dt(not_after_dt)
            elif 'Subject Alternative Name' in line:
                in_san = True
            elif in_san and line.strip():
                info['subject_alt_names'].append(line.strip())
                in_san = False
        info['days_remaining'] = _days_from_datetime(not_after_dt)
        info['expired'] = info['days_remaining'] is not None and info['days_remaining'] < 0
        if not_before_dt is not None:
            nb_days = _days_from_datetime(not_before_dt)
            info['not_yet_valid'] = nb_days is not None and nb_days > 0
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    return info


def describe_certificate(der_data, dict_info=None, role=None, show_pem=False):
    """
    Describe un certificado (DER) con el mismo formato que el bloque B
    del diagnostico. Si dict_info no se proporciona (p. ej. certificados
    de la cadena), los datos se derivan ejecutando openssl x509 sobre un
    PEM temporal.
    """
    cert_info = {}
    if role:
        cert_info['role'] = role

    if dict_info is not None:
        cert_info['subject'] = format_rdn(dict_info.get('subject'))
        cert_info['subject_raw'] = dict_info.get('subject')
        cert_info['issuer'] = format_rdn(dict_info.get('issuer'))
        cert_info['issuer_raw'] = dict_info.get('issuer')
        cert_info['serial_number'] = dict_info.get('serialNumber', '(no disponible)')
        not_before = dict_info.get('notBefore', '')
        not_after = dict_info.get('notAfter', '')
        cert_info['not_before'] = format_datetime(not_before)
        cert_info['not_after'] = format_datetime(not_after)
        cert_info['days_remaining'] = days_remaining(not_after)
        cert_info['expired'] = (
            cert_info['days_remaining'] is not None and cert_info['days_remaining'] < 0
        )
        cert_info['not_yet_valid'] = _not_yet_valid(not_before)
        cert_info['subject_alt_names'] = extract_sans(dict_info)
        cert_info['ocsp_responders'] = dict_info.get('OCSP', [])
        cert_info['ca_issuers'] = dict_info.get('caIssuers', [])
        cert_info['crl_distribution_points'] = dict_info.get('crlDistributionPoints', [])
        cert_info['key_usage'] = dict_info.get('keyUsage', '(no disponible)')
        cert_info['extended_key_usage'] = dict_info.get('extendedKeyUsage', '(no disponible)')
        cert_info['signature_algorithm'] = dict_info.get('signatureAlgorithm', '(no disponible)')
        cert_info['public_key_size_bits'] = dict_info.get('publicKeySize', '(no disponible)')
        cert_info['version'] = dict_info.get('version', '(no disponible)')
    else:
        cert_info.update(_describe_cert_with_openssl(der_data))

    cert_info['fingerprint_sha1'] = cert_fingerprint(der_data, 'sha1')
    cert_info['fingerprint_sha256'] = cert_fingerprint(der_data, 'sha256')
    cert_info['der_size_bytes'] = len(der_data)

    if show_pem:
        try:
            pem_bytes = der_to_pem(der_data)
            if pem_bytes is None:
                raise ValueError('no se pudo convertir DER a PEM')
            cert_info['pem'] = to_str(pem_bytes)
        except Exception as e:
            cert_info['pem_error'] = str(e)

    return cert_info


def _chain_item_to_der(item):
    """Convierte un item de cadena (bytes, PEM str u objeto Certificate) a DER."""
    if isinstance(item, bytes):
        return item
    # Los objetos _ssl.Certificate pueden ser subclases de str: comprobar
    # public_bytes ANTES de tratar el item como texto plano.
    pb = getattr(item, 'public_bytes', None)
    if pb is not None:
        result = None
        enc = getattr(ssl, 'Encoding', None)
        try:
            result = pb(enc.DER) if enc is not None else pb()
        except TypeError:
            try:
                result = pb()
            except Exception:
                return None
        except Exception:
            return None
        if isinstance(result, bytes):
            if b'BEGIN CERTIFICATE' in result:
                return pem_to_der(result)
            return result
        if isinstance(result, STRING_TYPES) and 'BEGIN CERTIFICATE' in result:
            return pem_to_der(result)
        return None
    if isinstance(item, STRING_TYPES):
        if 'BEGIN CERTIFICATE' in item:
            return pem_to_der(item)
        return None
    return None


def get_peer_chain_objects(sock):
    """
    Devuelve (leaf_der, chain_ders, leaf_info) del certificado/cadena del
    cliente. Funciona incluso tras un handshake FALLIDO en Python 3.10+
    (get_verified_chain/get_unverified_chain no comprueban el estado del
    handshake). En versiones anteriores degrada a get_peer_cert_chain y
    getpeercert (que solo funcionan tras un handshake exitoso).
    """
    leaf_der = None
    chain_ders = []
    leaf_info = None

    # Informacion completa de la hoja (solo si el handshake tuvo exito)
    try:
        pc = sock.getpeercert()
        if pc:
            leaf_info = pc
    except Exception:
        leaf_info = None

    candidates = []
    sslobj = getattr(sock, '_sslobj', None)
    if sslobj is not None:
        candidates.append(sslobj)
    candidates.append(sock)

    for obj in candidates:
        for meth_name in ('get_verified_chain', 'get_unverified_chain'):
            meth = getattr(obj, meth_name, None)
            if meth is None:
                continue
            try:
                chain = meth()
            except Exception:
                continue
            if not chain:
                continue
            ders = [_chain_item_to_der(c) for c in chain]
            ders = [d for d in ders if d is not None]
            if not ders:
                continue
            leaf_der = ders[0]
            chain_ders = ders[1:]
            if leaf_info is None:
                try:
                    if hasattr(chain[0], 'get_info'):
                        leaf_info = chain[0].get_info()
                except Exception:
                    leaf_info = None
            break
        if leaf_der is not None:
            break

    if leaf_der is None:
        # Fallback (<= 3.9 / Py2): solo tras handshake exitoso
        chain_method = getattr(sock, 'get_peer_cert_chain', None)
        if chain_method is not None:
            try:
                raw_chain = chain_method()
                if raw_chain:
                    ders = [_chain_item_to_der(c) for c in raw_chain]
                    ders = [d for d in ders if d is not None]
                    if ders:
                        leaf_der = ders[0]
                        chain_ders = ders[1:]
            except Exception:
                pass
        if leaf_der is None:
            try:
                leaf_der = sock.getpeercert(binary_form=True)
            except Exception:
                pass

    return leaf_der, chain_ders, leaf_info


def _veredicto_espanol(output, output_sin_purpose):
    """Mapea la salida de openssl verify a veredictos legibles en espanol."""
    text = '\n'.join([o for o in (output, output_sin_purpose) if o])
    veredictos = []
    if ': OK' in text:
        veredictos.append('OK: el certificado ES de confianza para la CA configurada en --ca-cert.')
        return veredictos
    mapping = [
        ('unable to get local issuer certificate',
         'NO se encuentra el emisor (CA) de este certificado en --ca-cert. '
         'La CA del WAF no esta en el bundle, o la cadena enviada no incluye '
         'el intermedio necesario.'),
        ('self-signed certificate',
         'El certificado es AUTOFIRMADO: no esta emitido por la CA esperada.'),
        ('self signed certificate',
         'El certificado es AUTOFIRMADO: no esta emitido por la CA esperada.'),
        ('certificate has expired',
         'El certificado esta EXPIRADO.'),
        ('certificate is not yet valid',
         'El certificado AUN NO ES VALIDO (notBefore en el futuro).'),
        ('certificate revoked',
         'El certificado esta REVOCADO (o no se puede consultar su estado).'),
        ('unsupported certificate purpose',
         'El proposito del certificado (EKU) no es compatible con "sslclient" '
         '(uso como cliente TLS).'),
        ('invalid CA certificate',
         'La CA configurada no es valida como emisora de este certificado.'),
    ]
    for needle, veredicto in mapping:
        if needle in text:
            veredictos.append(veredicto)
    if not veredictos:
        veredictos.append('Verificacion fallida (consulte la salida completa de openssl verify).')
    return veredictos


def run_openssl_verify(leaf_der, chain_ders, ca_cert_file):
    """
    Verifica el certificado (hoja + opcionalmente cadena) contra la CA
    configurada con 'openssl verify'. Devuelve el resultado con el
    veredicto en espanol.
    """
    result = {
        'ca_cert_file': ca_cert_file,
        'commands': [],
        'exit_code': None,
        'output': '',
        'output_sin_purpose': '',
        'ok': False,
        'veredicto_espanol': [],
    }
    tmpdir = None
    try:
        leaf_pem = der_to_pem(leaf_der)
        if leaf_pem is None:
            result['error'] = 'no se pudo convertir el certificado a PEM'
            return result
        tmpdir = tempfile.mkdtemp(prefix='tls_tester_verify_')
        leaf_path = os.path.join(tmpdir, 'leaf.pem')
        with open(leaf_path, 'wb') as f:
            f.write(leaf_pem)
        chain_path = None
        if chain_ders:
            chain_path = os.path.join(tmpdir, 'chain.pem')
            with open(chain_path, 'wb') as f:
                for der in chain_ders:
                    der_pem = der_to_pem(der)
                    if der_pem is not None:
                        f.write(der_pem)
        cmd1 = ['openssl', 'verify', '-CAfile', ca_cert_file, '-purpose', 'sslclient']
        if chain_path:
            cmd1 += ['-untrusted', chain_path]
        cmd1.append(leaf_path)
        rc, out, err = run_openssl(cmd1)
        result['commands'].append(' '.join(cmd1))
        result['exit_code'] = rc
        result['output'] = out if out else err
        result['ok'] = (rc == 0)
        if rc != 0:
            # Segunda pasada sin -purpose para aislar errores de proposito/EKU
            cmd2 = ['openssl', 'verify', '-CAfile', ca_cert_file]
            if chain_path:
                cmd2 += ['-untrusted', chain_path]
            cmd2.append(leaf_path)
            rc2, out2, err2 = run_openssl(cmd2)
            result['commands'].append(' '.join(cmd2))
            result['output_sin_purpose'] = out2 if out2 else err2
    except Exception as e:
        result['error'] = str(e)
    finally:
        if tmpdir is not None:
            shutil.rmtree(tmpdir, ignore_errors=True)
    result['veredicto_espanol'] = _veredicto_espanol(result['output'], result['output_sin_purpose'])
    return result


def interpret_handshake_error(exc, verify_code, verify_message, leaf_captured, cert_reqs, ca_configured, timeout):
    """
    Interpreta un fallo de handshake TLS y devuelve un dict con
    quien_rechazo, alert, motivo y lineas de guia.
    """
    text = str(exc)
    r = {'quien_rechazo': 'desconocido', 'alert': None, 'motivo': '', 'guia': []}

    if verify_code is not None or 'CERTIFICATE_VERIFY_FAILED' in text:
        # El SERVIDOR rechazo el certificado del cliente
        r['quien_rechazo'] = 'servidor'
        if verify_code is not None:
            motivo_code = VERIFY_CODE_TABLE.get(verify_code, '(sin descripcion)')
            r['motivo'] = 'El SERVIDOR rechazo el certificado del cliente (verify_code={}): {}.'.format(
                verify_code, verify_message or motivo_code)
        else:
            r['motivo'] = 'El SERVIDOR rechazo el certificado del cliente: {}'.format(
                verify_message or text)
        if not ca_configured:
            r['guia'].append('El servidor pidio certificado de cliente pero NO hay --ca-cert '
                             'configurado para validarlo. Use --ca-cert ca.pem con la CA que '
                             'emite el certificado del WAF.')
        if verify_code == 20:
            r['guia'].append('No se encuentra el emisor en --ca-cert. Causas tipicas: '
                             '(1) el WAF usa otra CA, (2) el WAF no envia los certificados '
                             'intermedios de su cadena, (3) --ca-cert apunta a una CA distinta '
                             'de la que emite el certificado del WAF.')
        elif verify_code in (18, 19):
            r['guia'].append('El certificado del WAF es autofirmado o su cadena termina en un '
                             'autofirmado no confiable.')
        elif verify_code == 10:
            r['guia'].append('El certificado del WAF esta EXPIRADO.')
        elif verify_code == 9:
            r['guia'].append('El certificado del WAF AUN NO ES VALIDO (notBefore futuro).')
        elif verify_code == 26:
            r['guia'].append('El certificado del WAF no sirve como certificado de CLIENTE '
                             '(extendedKeyUsage sin clientAuth).')
    elif 'PEER_DID_NOT_RETURN_A_CERTIFICATE' in text or \
            ('certificate required' in text.lower() and not leaf_captured):
        # El servidor exigia certificado y el cliente no presento ninguno
        r['quien_rechazo'] = 'servidor'
        r['motivo'] = 'MTLS exigia certificado de cliente y el cliente no presento ninguno.'
        r['guia'].append('El WAF no esta configurado para presentar certificado de cliente '
                         'hacia este origen (perfil mTLS ausente o deshabilitado en el WAF).')
    else:
        m = re.search(r'\balert\s+([a-z0-9_ ]+)', text)
        if m:
            alert = m.group(1).strip()
            if alert == 'certificate required':
                # Alerta ENVIADA por el servidor (TLS 1.3): no presentaron certificado
                r['quien_rechazo'] = 'servidor'
                r['alert'] = alert
                r['motivo'] = 'MTLS exigia certificado de cliente y el cliente no presento ninguno.'
                r['guia'].append('El WAF no esta configurado para presentar certificado de '
                                 'cliente hacia este origen.')
            elif alert == 'handshake failure' and not leaf_captured:
                r['quien_rechazo'] = 'ambiguo'
                r['alert'] = alert
                r['motivo'] = ('Alerta "handshake failure" sin certificado de cliente capturado: '
                               'puede ser una alerta ENVIADA por el servidor (p. ej. certificado '
                               'exigido y no presentado) o RECIBIDA del cliente.')
            else:
                r['quien_rechazo'] = 'cliente'
                r['alert'] = alert
                guia_alert = ALERT_GUIDANCE.get(alert, '')
                r['motivo'] = 'El CLIENTE envio la alerta "{}" durante el handshake: {}.'.format(
                    alert, guia_alert or 'el cliente aborto el handshake.')
                if alert in ('unknown ca', 'certificate unknown', 'bad certificate',
                             'certificate expired', 'certificate revoked'):
                    r['guia'].append('El cliente (WAF) RECHAZO el certificado de servidor de '
                                     'tls-tester: no confia en su CA. Instale la CA del certificado '
                                     'de servidor en el almacen de confianza del WAF, o use un '
                                     'certificado emitido por la CA corporativa (--cert/--key).')
                if alert == 'certificate unknown':
                    r['guia'].append('Nota: "certificate unknown" (TLS 1.3) equivale a '
                                     '"unknown ca" (TLS 1.2).')
        elif 'timed out' in text.lower():
            r['quien_rechazo'] = 'ninguno'
            r['motivo'] = 'TIMEOUT: el cliente no completo el handshake en {} segundos.'.format(timeout)
            r['guia'].append('Posibles causas: WAF colgado, firewalls intermedios, problemas de '
                             'red/MTU, o un cliente que conecta y no habla TLS. Aumente '
                             '--handshake-timeout si la red es lenta.')
        elif 'NO_SHARED_CIPHER' in text or 'no shared cipher' in text.lower():
            r['quien_rechazo'] = 'ninguno'
            r['motivo'] = 'Desajuste de suites de cifrado entre el cliente (WAF) y el servidor.'
            r['guia'].append('Revise las suites de cifrado configuradas en el WAF para este origen.')
        elif 'WRONG_VERSION_NUMBER' in text or 'wrong version number' in text.lower() or \
                'unsupported protocol' in text.lower() or 'no protocols available' in text.lower():
            r['quien_rechazo'] = 'ninguno'
            r['motivo'] = 'Desajuste de version/protocolo TLS entre el cliente (WAF) y el servidor.'
        elif 'unexpected eof' in text.lower() or 'EOF occurred' in text:
            r['quien_rechazo'] = 'ninguno'
            r['motivo'] = 'El cliente cerro la conexion a mitad del handshake.'
        else:
            r['motivo'] = 'Fallo de handshake sin clasificar: {}'.format(text)

    r['guia'].append('Si el fallo ocurre via WAF pero el acceso directo al origen funciona: '
                     'el WAF reescribe la conexion TLS (termina y re-origina). Compare los '
                     'certificados que cada extremo ve.')
    r['guia'].append('Directo al origen OK + via WAF FAIL => normalmente: la CA del certificado '
                     'del WAF no esta en --ca-cert, o el certificado de servidor no es de '
                     'confianza para el WAF, o la cadena del WAF esta incompleta.')
    return r


# ---------------------------------------------------------------------------
# Salida JSON con numeracion protegida contra carreras entre hilos
# ---------------------------------------------------------------------------

_output_counters = {}
_output_counter_lock = threading.Lock()


def make_json_safe(obj):
    """Convierte recursivamente un objeto a tipos serializables JSON."""
    if isinstance(obj, dict):
        return {str(k): make_json_safe(v) for k, v in obj.items()}
    elif isinstance(obj, (list, tuple)):
        return [make_json_safe(item) for item in obj]
    elif isinstance(obj, bytes):
        return obj.decode('utf-8', errors='replace')
    elif isinstance(obj, STRING_TYPES):
        return to_str(obj)
    elif isinstance(obj, INTEGER_TYPES):
        return int(obj)
    elif isinstance(obj, float):
        return obj
    elif isinstance(obj, bool):
        return obj
    elif obj is None:
        return None
    else:
        return str(obj)


def next_output_number(prefix, output_dir):
    """Siguiente numero secuencial para ficheros prefix_NNNN.json (protegido con lock)."""
    with _output_counter_lock:
        key = (prefix, output_dir)
        if key not in _output_counters:
            max_n = 0
            try:
                for f in os.listdir(output_dir):
                    if f.startswith(prefix + '_') and f.endswith('.json'):
                        try:
                            n = int(f[len(prefix) + 1:-5])
                            if n > max_n:
                                max_n = n
                        except ValueError:
                            pass
            except OSError:
                pass
            _output_counters[key] = max_n
        _output_counters[key] += 1
        return _output_counters[key]


def save_json_report(prefix, data, output_dir):
    """Guarda un dict de diagnostico como JSON prefix_NNNN.json."""
    if not output_dir:
        return
    try:
        n = next_output_number(prefix, output_dir)
        filename = '{}_{:04d}.json'.format(prefix, n)
        filepath = os.path.join(output_dir, filename)
        json_str = json.dumps(make_json_safe(data), indent=2, sort_keys=True, ensure_ascii=False)
        with open(filepath, 'w') as f:
            f.write(to_str(json_str))
        print('[{}] JSON guardado en {}'.format(
            datetime.datetime.now().strftime('%H:%M:%S'), filepath), file=sys.stderr)
    except Exception as e:
        print('[{}] ERROR al guardar JSON: {}'.format(
            datetime.datetime.now().strftime('%H:%M:%S'), e), file=sys.stderr)


def report_handshake_failure(diag, ssl_config):
    """Imprime el informe estructurado de un fallo de handshake TLS y lo guarda como JSON."""
    sep = '=' * 78
    print('\n' + sep)
    print('  FALLO DE HANDSHAKE TLS — {}'.format(
        datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')))
    print(sep)

    print('\n  [CLIENTE]')
    print('  Direccion  : {}:{}'.format(
        diag.get('client', {}).get('ip', ''), diag.get('client', {}).get('port', '')))

    print('\n  [ERROR]')
    print('  Tipo       : {}'.format(diag.get('error', {}).get('type', '')))
    print('  Mensaje    : {}'.format(diag.get('error', {}).get('message', '')))
    if diag.get('error', {}).get('verify_code') is not None:
        print('  Verify code: {} — {}'.format(
            diag['error']['verify_code'],
            diag['error'].get('verify_message', '(sin mensaje)')))

    interp = diag.get('interpretacion') or {}
    print('\n  [INTERPRETACION]')
    print('  Quien rechazo: {}'.format(interp.get('quien_rechazo', 'desconocido')))
    if interp.get('alert'):
        print('  Alerta       : {}'.format(interp['alert']))
    if interp.get('motivo'):
        print('  Motivo       : {}'.format(interp['motivo']))
    for g in interp.get('guia', []):
        print('  Guia         : {}'.format(g))

    cert = diag.get('client_certificate')
    if cert:
        print('\n  [CERTIFICADO DEL CLIENTE (capturado a pesar del fallo)]')
        print('  Subject    : {}'.format(cert.get('subject', '')))
        print('  Issuer     : {}'.format(cert.get('issuer', '')))
        print('  Serial     : {}'.format(cert.get('serial_number', '')))
        print('  Not Before : {}'.format(cert.get('not_before', '')))
        print('  Not After  : {}'.format(cert.get('not_after', '')))
        print('  SHA1       : {}'.format(cert.get('fingerprint_sha1', '')))
        print('  SHA256     : {}'.format(cert.get('fingerprint_sha256', '')))
        if cert.get('pem'):
            print('\n  [PEM del certificado]')
            print(cert['pem'])
        chain = diag.get('client_certificate_chain') or []
        if chain:
            print('\n  [CADENA DEL CLIENTE]')
            for i, c in enumerate(chain):
                print('  [{}/{}] Subject: {}'.format(i + 1, len(chain), c.get('subject', '')))
                print('         Issuer : {}'.format(c.get('issuer', '')))
                print('         SHA256 : {}'.format(c.get('fingerprint_sha256', '')))
                print('         Origen : {}'.format(c.get('role', 'enviada por el cliente')))
        ov = diag.get('openssl_verify')
        if ov:
            print('\n  [VEREDICTO OPENSSL VERIFY]')
            for cmd in ov.get('commands', []):
                print('  Comando     : {}'.format(cmd))
            print('  Salida      : {}'.format(ov.get('output', '')))
            if ov.get('output_sin_purpose'):
                print('  Sin -purpose: {}'.format(ov['output_sin_purpose']))
            for v in ov.get('veredicto_espanol', []):
                print('  Veredicto   : {}'.format(v))

    srv_cert = diag.get('server_certificate') or {}
    if srv_cert.get('subject'):
        print('\n  [CERTIFICADO DEL SERVIDOR (el que vio el WAF)]')
        print('  Subject    : {}'.format(srv_cert['subject']))
        print('  Issuer     : {}'.format(srv_cert.get('issuer', '')))
        print('  SHA256     : {}'.format(srv_cert.get('fingerprint_sha256', '')))

    print('\n' + sep)
    sys.stdout.flush()

    if ssl_config and ssl_config.get('output_dir'):
        save_json_report('handshake_error', diag, ssl_config['output_dir'])


