                html += ' <span class="badge badge-error">EXPIRADO</span>'
            if cert.get('not_yet_valid'):
                html += ' <span class="badge badge-warn">AUN NO VALIDO</span>'
            if not cert.get('expired') and not cert.get('not_yet_valid'):
                remaining = cert.get('days_remaining')
                if remaining is not None:
                    if remaining < 30:
                        html += ' <span class="badge badge-warn">EXPIRA EN {} DIAS</span>'.format(remaining)
                    else:
                        html += ' <span class="badge badge-ok">VALIDO ({} dias)</span>'.format(remaining)
            html += '</p>'

            html += '<h3>Subject</h3><table>'
            html += _row('DN completo', '<strong>{}</strong>'.format(cert.get('subject', '')))

            # Desglose del subject
            if cert.get('subject_raw'):
                for rdn in cert['subject_raw']:
                    for attr in rdn:
                        html += _row('  ' + attr[0], attr[1])
            html += '</table>'

            html += '<h3>Issuer</h3><table>'
            html += _row('DN completo', cert.get('issuer', ''))
            if cert.get('issuer_raw'):
                for rdn in cert['issuer_raw']:
                    for attr in rdn:
                        html += _row('  ' + attr[0], attr[1])
            html += '</table>'

            html += '<h3>Datos</h3><table>'
            html += _row('Numero de serie', cert.get('serial_number', ''))
            html += _row('Valido desde', cert.get('not_before', ''))
            html += _row('Valido hasta', cert.get('not_after', ''))
            html += _row('Dias restantes', str(cert.get('days_remaining', '')))
            html += _row('Version', str(cert.get('version', '')))
            html += _row('Algoritmo de firma', cert.get('signature_algorithm', ''))
            html += _row('Tamano clave publica', str(cert.get('public_key_size_bits', '')) + ' bits')
            html += '</table>'

            sans = cert.get('subject_alt_names', [])
            if sans:
                html += '<h3>Subject Alternative Names</h3><table>'
                for san in sans:
                    html += _row('SAN', san)
                html += '</table>'

            html += '<h3>Extensiones</h3><table>'
            html += _row('Key Usage', cert.get('key_usage', ''))
            html += _row('Extended Key Usage', cert.get('extended_key_usage', ''))
            ocsp = cert.get('ocsp_responders', [])
            html += _row('OCSP Responders', ', '.join(ocsp) if ocsp else '(ninguno)')
            ca_issuers = cert.get('ca_issuers', [])
            html += _row('CA Issuers URL', ', '.join(ca_issuers) if ca_issuers else '(ninguno)')
            crl = cert.get('crl_distribution_points', [])
            html += _row('CRL Distribution', ', '.join(crl) if crl else '(ninguno)')
            html += '</table>'

            html += '<h3>Huellas (Fingerprints)</h3><table>'
            sha1 = cert.get('fingerprint_sha1', '')
            sha256 = cert.get('fingerprint_sha256', '')
            html += _row('SHA1', '<span class="fingerprint">{}</span>'.format(sha1))
            html += _row('SHA256', '<span class="fingerprint">{}</span>'.format(sha256))
            html += _row('DER size', '{} bytes'.format(cert.get('der_size_bytes', '')))
            html += '</table>'

            pem = cert.get('pem', '')
            if pem:
                html += '<h3>Certificado en PEM</h3><pre class="pem">{}</pre>'.format(pem)

        else:
            html += '<p><span class="badge badge-warn">NO PRESENTE</span></p>'
            html += '<p>{}</p>'.format(cert.get('note', ''))
            if cert.get('error'):
                html += '<p>Error: <code>{}</code></p>'.format(cert['error'])
        html += '</div>'

        # --- HTTP ---
        http_inf = diag['http']
        html += '<h2>Peticion HTTP</h2><div class="section-box">'
        html += '<h3>Request Line</h3><table>'
        method = http_inf.get('method', '')
        html += _row('Metodo', '<span class="badge badge-info">{}</span>'.format(method))
        html += _row('Path', '<code>{}</code>'.format(http_inf.get('path', '')))
        html += _row('Version HTTP', http_inf.get('request_version', ''))
        html += _row('Client IP', '{}:{}'.format(
            http_inf.get('client_ip', ''), http_inf.get('client_port', '')))
        html += _row('User-Agent', http_inf.get('user_agent', ''))
        html += _row('Content-Type', http_inf.get('content_type', ''))
        html += '</table>'

        # Query params
        qp = http_inf.get('query_params', {})
        if qp:
            html += '<h3>Query String</h3><table>'
            for k, v in sorted(qp.items()):
                html += _row(str(k), str(v))
            html += '</table>'

        # Headers
        headers = http_inf.get('headers', {})
        if headers:
            html += '<h3>Cabeceras HTTP</h3><table>'
            for key in sorted(headers.keys()):
                html += _row(str(key), str(headers[key]))
            html += '</table>'

        # Body
        body_size = http_inf.get('body_size_bytes', 0)
        if body_size > 0:
            html += '<h3>Body ({} bytes)</h3>'.format(body_size)
            if http_inf.get('body_is_text'):
                body_text = http_inf.get('body_text', '')
                html += '<pre>{}</pre>'.format(body_text)
            else:
                hexd = http_inf.get('body_hexdump', '')
                html += '<pre>{}</pre>'.format(hexd)
        else:
            html += '<p><em>Sin body</em></p>'

        html += '</div>'

        # --- Variables de entorno ---
        env_info = diag['environment']
